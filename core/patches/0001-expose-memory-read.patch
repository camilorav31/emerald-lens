index 14d9a8a..00314e5 100644
--- a/src/platform/wasm/main.c
+++ b/src/platform/wasm/main.c
@@ -468,6 +468,26 @@ EMSCRIPTEN_KEEPALIVE bool loadStateSlot(int slot, int flags) {
 	return mCoreLoadState(renderer->core, slot, flags);
 }
 
+#define MEMORY_READ_MAX 0x10000
+static uint8_t memoryReadBuffer[MEMORY_READ_MAX];
+
+// rawRead8 is the debugger view: no bus side effects. The interrupt makes the
+// copy a consistent snapshot between emulated instructions. The core thread is
+// only created on the first main loop tick after loadGame, so it may not exist yet.
+EMSCRIPTEN_KEEPALIVE uint8_t* readMemoryRange(uint32_t address, uint32_t length) {
+	if (!renderer->core || length == 0 || length > MEMORY_READ_MAX) {
+		return NULL;
+	}
+	if (renderer->thread)
+		mCoreThreadInterrupt(renderer->thread);
+	for (uint32_t i = 0; i < length; ++i) {
+		memoryReadBuffer[i] = renderer->core->rawRead8(renderer->core, address + i, -1);
+	}
+	if (renderer->thread)
+		mCoreThreadContinue(renderer->thread);
+	return memoryReadBuffer;
+}
+
